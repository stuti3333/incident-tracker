# copy to .env and export, or set in your shell
MONGODB_URI=mongodb://127.0.0.1:27017/incident_tracker
PORT=3000
# role tokens: token:role,token:role  (viewer < developer < admin)
TOKENS=admin-token:admin,dev-token:developer,view-token:viewer
# set to enforce HMAC verification of GitHub webhooks
GITHUB_WEBHOOK_SECRET=
